# ==========================================
# RescueGrid Environment Variables
# ==========================================

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# FalkorDB Connection (Cloud or Local Docker)
# If using connection URL format:
FALKORDB_URL=falkor://username:password@host:port

# Or individual connection params (if preferred):
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
